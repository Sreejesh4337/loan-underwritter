# OpenAI API key. Required for LLM-backed extraction/decision steps;
# without it the service falls back to deterministic extractors (llm_available() == False).
OPENAI_API_KEY=

# Document deduplication cooldown (in days). Documents processed within this
# window will be rejected on re-upload. Default: 90 (3 months).
DOCUMENT_COOLDOWN_DAYS=90

# DeepEval Configuration
# Model used by DeepEval to judge LLM outputs (default: gpt-4o)
DEEPEVAL_JUDGE_MODEL=gpt-4o

# Optional model overrides (defaults shown)
CHEAP_MODEL_NAME=gpt-4o-mini
STRONG_MODEL_NAME=gpt-4o
